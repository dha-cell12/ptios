{
  "schema_version": 1,
  "product": "tlinkauto-rootfull",
  "runtime": "rootfull",
  "phase": 6,
  "license_contract_version": 1,
  "integration_mode": "task_and_long_running_component_gate",
  "configuration_bundle": "Applications/TLinkauto.app/LicenseConfig.plist",
  "application_bundle_identifiers": [
    "com.tlinkauto.tlinkauto",
    "com.tlinkauto.streamcontrol"
  ],
  "verifier_components": [
    {
      "component": "application_lifecycle",
      "binary": "Applications/TLinkauto.app/TLinkauto",
      "source": "stream-app/app/LicenseLifecycleCoordinator.mm"
    },
    {
      "component": "application_license_ui",
      "binary": "Applications/TLinkauto.app/TLinkauto",
      "source": "stream-app/app/LicenseViewController.mm"
    },
    {
      "component": "license_authority",
      "binary": "usr/libexec/tlinkauto-licensed",
      "source": "license-authority/main.mm"
    },
    {
      "component": "task_daemon",
      "binary": "usr/bin/tlinkautod",
      "source": "tlinkauto-binary/SocketServer.mm"
    },
    {
      "component": "task_client",
      "binary": "usr/bin/tlinkautob",
      "source": "tlinkauto-binary/SocketServer.mm"
    },
    {
      "component": "springboard_dispatch",
      "binary": "Library/MobileSubstrate/DynamicLibraries/pccontrol.dylib",
      "source": "pccontrol/Task.xm"
    },
    {
      "component": "h264_stream",
      "binary": "Library/MobileSubstrate/DynamicLibraries/pccontrol.dylib",
      "source": "pccontrol/H264Stream.xm"
    },
    {
      "component": "script_runtime",
      "binary": "Library/MobileSubstrate/DynamicLibraries/pccontrol.dylib",
      "source": "pccontrol/ScriptPlayer.xm"
    },
    {
      "component": "script_helper",
      "binary": "usr/libexec/tlinkauto-jsd",
      "source": "tlinkauto-jsd/TLinkJSHelperServer.mm"
    },
    {
      "component": "vpn_broker",
      "binary": "usr/libexec/tlinkauto-vpnd",
      "source": "vpn-broker/main.mm"
    }
  ],
  "diagnostic_tasks": {
    "60": "springboard_base64_json_with_phase6_release_integrity_status",
    "75": "daemon_base64_json_with_phase6_release_integrity_status",
    "76": "daemon_cache_reload_or_generation_advance",
    "97": "daemon_capability_verifier_and_activation_lifecycle_summary"
  },
  "runtime_gate_active": true,
  "activation_ui_phase": 2,
  "activation_ui_active": true,
  "automatic_refresh": {
    "launch": true,
    "foreground": true,
    "refresh_window_seconds": 21600,
    "single_flight": true,
    "backoff_with_jitter": true
  },
  "daemon_cache_sync_task": 76,
  "task_policy": {
    "source": "shared/TLinkRootfullLicensePolicy.mm",
    "inventory": "license-rootfull-policy.json",
    "daemon_gate": true,
    "springboard_gate": true,
    "missing_policy": "fail_closed",
    "task10_deny": "silent_drop_with_counter"
  },
  "long_running_components": {
    "license_authority": {
      "feature": "all",
      "transport": "unix_socket_signed_nonce_status_v1",
      "socket": "/var/mobile/Library/TLinkauto/run/license-authority.sock",
      "failure_mode": "fail_closed"
    },
    "h264": {
      "feature": "stream",
      "accept_gate": true,
      "heartbeat_seconds": 5,
      "revocation_action": "shutdown_client_socket"
    },
    "script_runtime": {
      "feature": "script",
      "heartbeat_seconds": 1,
      "revocation_action": "cancel_runtime_close_file_handles"
    },
    "scheduler": {
      "feature": "script",
      "launch_time_recheck": true
    },
    "script_helper": {
      "feature": "script",
      "start_gate": true,
      "heartbeat_seconds": 1,
      "revocation_action": "cancel_javascript_wake_waiters_close_file_handles"
    },
    "vpn_broker": {
      "feature": "automation",
      "per_request_gate": true,
      "transport": "loopback_6014",
      "deny_action": "stable_error_no_networkextension_call"
    }
  },
  "ui_feature_policy": {
    "source": "stream-app/app/LicenseLifecycleCoordinator.mm",
    "snapshot": "immutable_memory_snapshot",
    "refresh_threads": "background_serial_queue",
    "refresh_triggers": [
      "launch",
      "foreground",
      "license_generation_change",
      "scripts_view_load",
      "settings_view_load"
    ],
    "backend_authority": true,
    "main_thread_signature_verification": false,
    "feature_visibility": {
      "scripts_play_and_add": "script",
      "settings_stream": "stream",
      "settings_control": "automation",
      "settings_script": "script"
    }
  },
  "performance_diagnostics": {
    "feature_check_count": true,
    "cache_hit_miss": true,
    "generation_poll_interval_ms": 250,
    "generation_poll_count": true,
    "feature_check_average_and_max_us": true,
    "status_refresh_average_and_max_ms": true,
    "ui_snapshot_refresh_average_and_max_ms": true
  },
  "release_hardening": {
    "package_runtime_coherence": {
      "active": true,
      "enforced_build_failure_mode": "fail_closed",
      "metadata": "Applications/TLinkauto.app/RootfullLicenseBuild.plist",
      "checks": [
        "phase",
        "contract",
        "compile_mode",
        "config_enforcement",
        "enforcement_behavior",
        "anti_rollback_policy"
      ]
    },
    "anti_rollback": {
      "active": true,
      "policy": "signed_device_checkpoint_v1",
      "checkpoint": "/var/mobile/Library/TLinkauto/license/trust_checkpoint.plist",
      "device_signature": "ECDSA_P256",
      "lease_issued_at_floor": true,
      "wall_clock_and_uptime_check": true,
      "clock_rollback_tolerance_seconds": 300,
      "known_limit": "checkpoint_deletion_by_root_resets_local_floor"
    },
    "release_evidence": {
      "dual_mode_artifacts": true,
      "device_regression": true,
      "jsonl_soak": true
    }
  },
  "next_runtime_gate_phase": 7
}
