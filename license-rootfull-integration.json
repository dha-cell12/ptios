{
  "schema_version": 1,
  "product": "tlinkauto-rootfull",
  "runtime": "rootfull",
  "phase": 3,
  "license_contract_version": 1,
  "integration_mode": "task_server_and_springboard_feature_gate",
  "configuration_bundle": "Applications/TLinkauto.app/LicenseConfig.plist",
  "application_bundle_identifiers": [
    "com.tlinkauto.tlinkauto",
    "com.tlinkauto.streamcontrol"
  ],
  "verifier_components": [
    {
      "component": "application_lifecycle",
      "binary": "Applications/TLinkauto.app/TLinkauto",
      "source": "stream-app/app/LicenseLifecycleCoordinator.mm"
    },
    {
      "component": "application_license_ui",
      "binary": "Applications/TLinkauto.app/TLinkauto",
      "source": "stream-app/app/LicenseViewController.mm"
    },
    {
      "component": "task_daemon",
      "binary": "usr/bin/tlinkautod",
      "source": "tlinkauto-binary/SocketServer.mm"
    },
    {
      "component": "task_client",
      "binary": "usr/bin/tlinkautob",
      "source": "tlinkauto-binary/SocketServer.mm"
    },
    {
      "component": "springboard_dispatch",
      "binary": "Library/MobileSubstrate/DynamicLibraries/pccontrol.dylib",
      "source": "pccontrol/Task.xm"
    }
  ],
  "diagnostic_tasks": {
    "60": "springboard_base64_json_with_phase2_lifecycle_status",
    "75": "daemon_base64_json_with_phase2_lifecycle_status",
    "76": "daemon_cache_reload_or_generation_advance",
    "97": "daemon_capability_verifier_and_activation_lifecycle_summary"
  },
  "runtime_gate_active": true,
  "activation_ui_phase": 2,
  "activation_ui_active": true,
  "automatic_refresh": {
    "launch": true,
    "foreground": true,
    "refresh_window_seconds": 21600,
    "single_flight": true,
    "backoff_with_jitter": true
  },
  "daemon_cache_sync_task": 76,
  "task_policy": {
    "source": "shared/TLinkRootfullLicensePolicy.mm",
    "inventory": "license-rootfull-policy.json",
    "daemon_gate": true,
    "springboard_gate": true,
    "missing_policy": "fail_closed",
    "task10_deny": "silent_drop_with_counter"
  },
  "next_runtime_gate_phase": 4
}
