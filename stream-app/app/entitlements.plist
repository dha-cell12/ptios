<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ================================================================ -->
	<!-- StreamControl app: UI + supervisor (spawns streamd, NON-root)     -->
	<!-- ================================================================ -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.developer.team-identifier</key>
	<string>StreamCtl</string>
	<key>application-identifier</key>
	<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	<key>keychain-access-groups</key>
	<array>
		<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	</array>
	<key>com.apple.developer.networking.vpn.api</key>
	<array>
		<string>allow-vpn</string>
	</array>
	<key>com.apple.SystemConfiguration.SCPreferences-write-access</key>
	<array>
		<string>preferences.plist</string>
	</array>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServicePhotos</string>
		<string>kTCCServicePhotosAdd</string>
	</array>

	<!-- ================================================================ -->
	<!-- Vision/CoreImage graphics allocation on TrollStore                -->
	<!--                                                                 -->
	<!-- Vision revision 2 converts its input to an internal 420f         -->
	<!-- IOSurface. These are the focused graphics user clients present   -->
	<!-- in XXTouch and absent from the first app-hosted OCR build.        -->
	<!-- ================================================================ -->
	<key>com.apple.QuartzCore.displayable-context</key>
	<true/>
	<key>com.apple.private.IOSurface.protected-access</key>
	<true/>
	<key>com.apple.private.allow-explicit-graphics-priority</key>
	<true/>
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>IOSurfaceRootUserClient</string>
		<string>IOSurfaceAcceleratorClient</string>
		<string>IOAccelContext</string>
		<string>IOAccelContext2</string>
		<string>IOAccelDevice</string>
		<string>IOAccelDevice2</string>
		<string>IOAccelSharedUserClient</string>
		<string>IOAccelSharedUserClient2</string>
		<string>IOAccelSubmitter2</string>
		<string>AGXCommandQueue</string>
		<string>AGXDevice</string>
		<string>AGXDeviceUserClient</string>
		<string>AGXSharedUserClient</string>
		<string>AGXGLContext</string>
	</array>
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>IOSurfaceRootUserClient</string>
		<string>IOSurfaceAcceleratorClient</string>
		<string>IOAccelContext</string>
		<string>IOAccelContext2</string>
		<string>IOAccelDevice</string>
		<string>IOAccelDevice2</string>
		<string>IOAccelSharedUserClient</string>
		<string>IOAccelSharedUserClient2</string>
		<string>IOAccelSubmitter2</string>
		<string>AGXCommandQueue</string>
		<string>AGXDevice</string>
		<string>AGXDeviceUserClient</string>
		<string>AGXSharedUserClient</string>
		<string>AGXGLContext</string>
	</array>

	<!-- ================================================================ -->
	<!-- RESERVED for future root helper (privhelper):                     -->
	<!-- persona-mgmt allows spawnRoot of binaries listed in              -->
	<!-- Info.plist TSRootBinaries. Harmless when no helper is spawned.    -->
	<!-- ================================================================ -->
	<key>com.apple.private.persona-mgmt</key>
	<true/>
</dict>
</plist>
