<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.developer.team-identifier</key>
	<string>StreamCtl</string>
	<key>application-identifier</key>
	<!-- Match the containing app bundle; clipboardd runs as its UIKit plugin. -->
	<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	<key>keychain-access-groups</key>
	<array>
		<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	</array>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.springboard-ui.client</key>
	<true/>
	<key>com.apple.backboard.client</key>
	<true/>
	<key>com.apple.assistivetouch.daemon</key>
	<true/>
	<key>com.apple.springboard.CFUserNotification</key>
	<true/>
	<key>com.apple.private.hid.client.event-monitor</key>
	<true/>
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.private.hid.client.event-filter</key>
	<true/>
	<key>com.apple.private.hid.client.service-protected</key>
	<true/>
	<key>com.apple.private.hid.manager.client</key>
	<true/>
	<key>com.apple.hid.system.user-access-service</key>
	<true/>
	<key>com.apple.hid.manager.user-access-device</key>
	<true/>
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>IOHIDEventSystemUserClient</string>
		<string>IOHIDLibUserClient</string>
		<string>IOHIDResourceUserClient</string>
		<string>IOHIDParamUserClient</string>
	</array>
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>IOHIDEventSystemUserClient</string>
		<string>IOHIDLibUserClient</string>
		<string>IOHIDResourceUserClient</string>
		<string>IOHIDParamUserClient</string>
	</array>

	<!-- Background system-pasteboard access. These are the relevant private
	     entitlements used by a working TrollStore automation runtime. -->
	<key>com.apple.Pasteboard.background-access</key>
	<true/>
	<key>com.apple.Pasteboard.originating-bundle-id-query</key>
	<true/>
	<key>com.apple.Pasteboard.trigger-janitor</key>
	<true/>
	<key>com.apple.Pasteboard.paste-unchecked</key>
	<true/>
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServicePasteboard</string>
	</array>
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.backboard.hid.services</string>
		<string>com.apple.backboardservices</string>
		<string>com.apple.iohideventsystem</string>
		<string>com.apple.frontboard.systemappservices</string>
		<string>com.apple.frontboard.workspace-service</string>
		<string>com.apple.springboard.services</string>
		<string>com.apple.springboardservices.secure</string>
	</array>
</dict>
</plist>
