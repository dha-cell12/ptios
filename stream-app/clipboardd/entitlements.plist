<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.developer.team-identifier</key>
	<string>StreamCtl</string>
	<key>application-identifier</key>
	<!-- Match the containing app bundle; clipboardd runs as its UIKit plugin. -->
	<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	<key>keychain-access-groups</key>
	<array>
		<string>StreamCtl.com.tlinkauto.streamcontrol</string>
	</array>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.springboard-ui.client</key>
	<true/>
	<key>com.apple.backboard.client</key>
	<true/>
	<key>com.apple.assistivetouch.daemon</key>
	<true/>
	<key>com.apple.springboard.CFUserNotification</key>
	<true/>
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.backboard.hid.services</string>
		<string>com.apple.backboardservices</string>
		<string>com.apple.frontboard.systemappservices</string>
		<string>com.apple.frontboard.workspace-service</string>
		<string>com.apple.springboard.services</string>
		<string>com.apple.springboardservices.secure</string>
	</array>
</dict>
</plist>
