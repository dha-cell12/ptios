#!/bin/sh

TLINK_DATA_ROOT="/var/mobile/Library/TLinkauto"
if [ -d /rootfs/var/mobile ]; then
    TLINK_DATA_ROOT="/rootfs/var/mobile/Library/TLinkauto"
fi

mkdir -p "$TLINK_DATA_ROOT"
if [ -f "$TLINK_DATA_ROOT/config.json" ]; then
    cp -p "$TLINK_DATA_ROOT/config.json" "$TLINK_DATA_ROOT/config.json.preinst-bak" 2>/dev/null
fi
launchctl unload /Library/LaunchDaemons/com.zjx.zxtouchd.plist 2>/dev/null
launchctl unload /Library/LaunchDaemons/com.tlinkauto.tlinkautod.plist 2>/dev/null
launchctl unload /Library/LaunchDaemons/com.tlinkauto.js-helper.plist 2>/dev/null
killall -9 zxtouchd 2>/dev/null
killall -9 tlinkautod 2>/dev/null
killall -9 tlinkauto-jsd 2>/dev/null
rm -f /Library/LaunchDaemons/com.zjx.zxtouchd.plist 2>/dev/null
rm -f /usr/bin/zxtouchd /usr/bin/zxtouchb 2>/dev/null
rm -f "$TLINK_DATA_ROOT/run/js-helper.sock" 2>/dev/null
rm -f "$TLINK_DATA_ROOT/run/js-helper.pid" 2>/dev/null
rm -f "$TLINK_DATA_ROOT/run/js-helper.lock" 2>/dev/null

