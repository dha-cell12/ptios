<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tlinkauto.js-helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/tlinkauto-jsd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardErrorPath</key>
    <string>/var/log/tlinkauto-jsd.err</string>
    <key>StandardOutPath</key>
    <string>/var/log/tlinkauto-jsd.log</string>
</dict>
</plist>
