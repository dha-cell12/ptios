{
  "name": "tlinkauto-license-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute tlinkauto-license --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute tlinkauto-license --remote --file=./schema.sql",
    "keys": "node ./scripts/generate-keys.mjs",
    "check": "node --check ./src/index.js && node --check ./scripts/generate-keys.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.24.3"
  }
}
