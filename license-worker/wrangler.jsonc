{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tlinkauto-license",
	"main": "src/index.js",
	"compatibility_date": "2026-07-01",
	"workers_dev": true,
	"vars": {
		"LICENSE_KEY_ID": "tlinkauto-test-2026-01",
		"LEASE_SECONDS": "86400",
		"OFFLINE_GRACE_SECONDS": "259200",
    "MAX_NEW_DEVICES_PER_WINDOW": "3",
    "DEVICE_CHURN_WINDOW_SECONDS": "2592000",
    "HARDWARE_POLICY_MODE": "observe",
    "HARDWARE_POLICY_VERSION": "1",
    "ALLOW_LEGACY_DEVICE_PROOF": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tlinkauto-license",
			"database_id": "5e220c10-db58-485e-b628-e2572eedc01c",
			"remote": true
		}
	]
}
